// Experiment 8 - the same CI/CD pipeline written for Jenkins (alternative to GitHub Actions)
pipeline {
    agent any
    environment {
        IMAGE = "wine-classifier:${env.BUILD_NUMBER}"
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Install') {
            steps { sh 'python3 -m venv venv && . venv/bin/activate && pip install -r requirements.txt' }
        }
        stage('Lint') {
            steps { sh '. venv/bin/activate && flake8 .' }
        }
        stage('Test') {
            steps { sh '. venv/bin/activate && pytest -v --junitxml=reports/junit.xml' }
        }
        stage('Train') {
            steps { sh '. venv/bin/activate && python src/train.py' }
        }
        stage('Validate model') {
            steps { sh '. venv/bin/activate && python src/validate_model.py' }
        }
        stage('Build image') {
            steps { sh 'docker build -t $IMAGE .' }
        }
        stage('Deploy') {
            when { branch 'main' }
            steps {
                sh 'docker run --rm $IMAGE'
                sh 'docker tag $IMAGE wine-classifier:latest'
            }
        }
    }
    post {
        always { archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true }
        success { echo 'Model trained, validated and deployed.' }
        failure { echo 'Pipeline failed - deployment skipped.' }
    }
}
